---
import settings from '../data/settings.json';const {lang='ar'}=Astro.props;const ar=lang==='ar';const p=ar?'':'/en';
---
<footer class="footer"><div class="container"><div class="foot"><div><div class="brand"><span class="logo">EFD</span><strong style="color:white">{ar?settings.organization_ar:settings.organization_en}</strong></div><p>{ar?settings.description_ar:settings.description_en}</p></div><div><h3>{ar?'المؤسسة':'Foundation'}</h3><a href={p+'/about'}>{ar?'من نحن':'About'}</a><a href={p+'/programs'}>{ar?'البرامج':'Programs'}</a><a href={p+'/projects'}>{ar?'المشاريع':'Projects'}</a></div><div><h3>{ar?'المحتوى':'Content'}</h3><a href={p+'/news'}>{ar?'الأخبار':'News'}</a><a href={p+'/stories'}>{ar?'القصص':'Stories'}</a><a href={p+'/reports'}>{ar?'التقارير':'Reports'}</a></div><div><h3>{ar?'تواصل':'Contact'}</h3><p>{settings.email}</p><p>{ar?settings.address_ar:settings.address_en}</p><a href={settings.facebook}>Facebook</a></div></div><div class="copy">© 2026 {ar?settings.organization_ar:settings.organization_en}</div></div></footer>
