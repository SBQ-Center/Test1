---
import settings from '../data/settings.json';const {lang='ar'}=Astro.props;const ar=lang==='ar';const p=ar?'':'/en';const nav=ar?[['الرئيسية','/'],['من نحن','/about'],['البرامج','/programs'],['المشاريع','/projects'],['الأخبار','/news'],['القصص','/stories'],['الفرص','/opportunities'],['تواصل','/contact']]:[['Home','/en/'],['About','/en/about'],['Programs','/en/programs'],['Projects','/en/projects'],['News','/en/news'],['Stories','/en/stories'],['Opportunities','/en/opportunities'],['Contact','/en/contact']];
---
<div class="top"><div class="container topin"><span>✉ {settings.email} · ☎ {settings.phone}</span><a href={p+'/complaints'}>{ar?'الشكاوى والملاحظات':'Feedback & complaints'}</a></div></div><header class="header"><nav class="container nav" aria-label={ar?'التنقل الرئيسي':'Main navigation'}><a class="brand" href={p||'/'}><span class="logo">EFD</span><span><strong>{ar?settings.organization_ar:settings.organization_en}</strong><small>{ar?settings.tagline_ar:settings.tagline_en}</small></span></a><div class="menu" id="main-menu">{nav.map(([n,u])=><a href={u}>{n}</a>)}</div><div class="navtools"><a class="lang" href={ar?'/en/':'/'}>{ar?'EN':'عربي'}</a><button class="menubtn" id="menu-button" aria-controls="main-menu" aria-expanded="false" aria-label={ar?'فتح القائمة':'Open menu'}>☰</button></div></nav></header><script>const b=document.getElementById('menu-button'),m=document.getElementById('main-menu');b?.addEventListener('click',()=>{const o=m?.classList.toggle('open')??false;b.setAttribute('aria-expanded',String(o))});m?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');b?.setAttribute('aria-expanded','false')}));document.addEventListener('keydown',e=>{if(e.key==='Escape'){m?.classList.remove('open');b?.setAttribute('aria-expanded','false')}});</script>
