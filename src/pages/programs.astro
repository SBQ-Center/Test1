---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('programs', (entry) => entry.id.startsWith('ar/') && !entry.data.draft)).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
---

<Base title="البرامج | EFD" description="البرامج" lang="ar">
  <PageHero title="البرامج" subtitle="محتوى المؤسسة المنشور" />
  <section class="section alt">
    <div class="container">
      {items.length ? (
        <div class="grid">
          {items.map((item) => <ContentCard entry={item} base="/programs" lang="ar" />)}
        </div>
      ) : (
        <p>لا توجد برامج منشورة حاليًا.</p>
      )}
    </div>
  </section>
</Base>
