---
import Base from '../../layouts/Base.astro';import ContentCard from '../../components/ContentCard.astro';import {getCollection} from 'astro:content';const news=(await getCollection('news',e=>e.id.startsWith('en/')&&!e.data.draft)).slice(0,3);const programs=(await getCollection('programs',e=>e.id.startsWith('en/')&&!e.data.draft)).sort((a,b)=>a.data.order-b.data.order).slice(0,6);
---
<Base title="Edrak Foundation for Development" description="A local non-governmental and non-profit development foundation." lang="en"><section class="hero"><div class="container"><article><span>Together for lasting impact</span><h1>Empowering communities to shape their future</h1><p>Development solutions advancing dignity, opportunity and resilience.</p><a class="btn light" href="/en/projects">Explore projects</a></article></div></section><div class="container stats"><div class="stat"><b>2015</b><span>Founded</span></div><div class="stat"><b>5</b><span>Programs</span></div><div class="stat"><b>EFD</b><span>Local foundation</span></div><div class="stat"><b>2</b><span>Languages</span></div></div><section class="section alt"><div class="container"><div class="head"><h2>Our programs</h2></div><div class="grid g3">{programs.map(entry=><ContentCard entry={entry} base="/en/programs" lang="en"/>)}</div></div></section><section class="section"><div class="container"><div class="head"><h2>Latest news</h2></div>{news.length?<div class="grid g3">{news.map(entry=><ContentCard entry={entry} base="/en/news" lang="en"/>)}</div>:<div class="notice">Add published news from Pages CMS.</div>}</div></section></Base>
