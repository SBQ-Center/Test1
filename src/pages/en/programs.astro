---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('programs', (entry) => entry.id.startsWith('en/') && !entry.data.draft)).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
---

<Base title="Programs | EFD" description="Programs" lang="en">
  <PageHero title="Programs" subtitle="Published foundation content" />
  <section class="section alt">
    <div class="container">
      {items.length ? (
        <div class="grid">
          {items.map((item) => <ContentCard entry={item} base="/en/programs" lang="en" />)}
        </div>
      ) : (
        <p>No published programs yet.</p>
      )}
    </div>
  </section>
</Base>
