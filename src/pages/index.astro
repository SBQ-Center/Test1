---
import Base from '../layouts/Base.astro';import ContentCard from '../components/ContentCard.astro';import {getCollection} from 'astro:content';const news=(await getCollection('news',e=>e.id.startsWith('ar/')&&!e.data.draft)).slice(0,3);const programs=(await getCollection('programs',e=>e.id.startsWith('ar/')&&!e.data.draft)).sort((a,b)=>a.data.order-b.data.order).slice(0,6);
---
<Base title="مؤسسة إدراك للتنمية" description="مؤسسة تنموية محلية غير حكومية وغير ربحية." lang="ar"><section class="hero"><div class="container"><article><span>معًا نحو أثر مستدام</span><h1>نُمكّن المجتمعات لتصنع مستقبلها</h1><p>حلول تنموية تعزز الكرامة والفرص والقدرة على الصمود.</p><a class="btn light" href="/projects">استكشف مشاريعنا</a></article></div></section><div class="container stats"><div class="stat"><b>2015</b><span>سنة التأسيس</span></div><div class="stat"><b>5</b><span>مجالات عمل</span></div><div class="stat"><b>EFD</b><span>مؤسسة محلية</span></div><div class="stat"><b>2</b><span>لغتان</span></div></div><section class="section alt"><div class="container"><div class="head"><h2>برامجنا</h2></div><div class="grid g3">{programs.map(entry=><ContentCard entry={entry} base="/programs" lang="ar"/>)}</div></div></section><section class="section"><div class="container"><div class="head"><h2>آخر الأخبار</h2></div>{news.length?<div class="grid g3">{news.map(entry=><ContentCard entry={entry} base="/news" lang="ar"/>)}</div>:<div class="notice">أضف أخبارًا منشورة من Pages CMS.</div>}</div></section></Base>
